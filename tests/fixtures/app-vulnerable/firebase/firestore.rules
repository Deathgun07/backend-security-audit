rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }
    match /orders/{id} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    match /{document=**} {
      allow read: if true;
    }
  }
}
